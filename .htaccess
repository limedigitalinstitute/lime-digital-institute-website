# Lime Digital Institute - Hostinger Server Configuration
DirectoryIndex index.html

# Custom Error Pages
ErrorDocument 404 /404.html

# Enable Rewrite Engine
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # For courses subdomain, serve 3-day-demo-class.html as root
  RewriteCond %{HTTP_HOST} ^courses\. [NC]
  RewriteCond %{REQUEST_URI} ^/?$
  RewriteRule ^$ 3-day-demo-class.html [L]

  # Redirect Trailing Slashes If not a folder
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} (.+)/$
  RewriteRule ^ %1 [L,R=301]

  # Clean URLs (serve .php without extension if requested, e.g. /api/register)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.php -f
  RewriteRule ^([^\.]+)$ $1.php [NC,L]

  # Clean URLs (serve .html without extension if requested)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^([^\.]+)$ $1.html [NC,L]
</IfModule>

# Caching & Compression for Fast Loading
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# CSS/JS/HTML must always be revalidated with the server (never served stale
# from browser cache) — content here changes on every deploy. Browser still
# gets a fast 304 when the file is unchanged, so this doesn't slow anything
# down; it just guarantees a real deploy is never masked by old cache.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
