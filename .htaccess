# Lime Digital Institute - Hostinger Server Configuration
DirectoryIndex index.html

# Custom Error Pages
ErrorDocument 404 /404.html

# Enable Rewrite Engine
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Old /demo stub page: permanent redirect to the demo landing page
  RewriteRule ^demo(\.html)?/?$ https://courses.limedigitalinstitute.org/ [R=301,L]

  # Private page sources are only readable by PHP
  RewriteRule ^_private(/|$) - [F,L]

  # Old spelling of the brochure URL
  RewriteRule ^broucher/?$ /brochure [R=301,L]

  # Never serve the git folder or other dot-directories
  RewriteRule (^|/)\.git(/|$) - [F,L]

  # Redirects below use an explicit https:// target: Apache sits behind Traefik
  # and would otherwise emit http:// Location headers (https -> http -> https).
  # For courses subdomain, serve 3-day-demo-class.html as root
  RewriteCond %{HTTP_HOST} ^courses\. [NC]
  RewriteCond %{REQUEST_URI} ^/?$
  RewriteRule ^$ 3-day-demo-class.html [L]

  # Courses subdomain gets its own sitemap and robots.txt (a sitemap may only
  # list URLs on the host it is served from).
  RewriteCond %{HTTP_HOST} ^courses\. [NC]
  RewriteRule ^sitemap\.xml$ sitemap-courses.xml [L]
  RewriteCond %{HTTP_HOST} ^courses\. [NC]
  RewriteRule ^robots\.txt$ robots-courses.txt [L]

  # /3-day-demo-class lives only on the courses subdomain now — redirect
  # the apex-domain URL there instead of serving a second, easy-to-confuse
  # copy of the same page.
  RewriteCond %{HTTP_HOST} !^courses\. [NC]
  RewriteCond %{REQUEST_URI} ^/3-day-demo-class(\.html)?/?$ [NC]
  RewriteRule ^ https://courses.limedigitalinstitute.org/ [R=301,L]

  # free-masterclass.html was renamed to masterclass.html — redirect both
  # the old clean URL and the old .html URL to the new clean URL.
  # QSA preserves any query string (e.g. ?id=...) on the redirect.
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s/+free-masterclass(\.html)?[?\s] [NC]
  RewriteRule ^ https://%{HTTP_HOST}/masterclass [R=301,L,QSA]

  # Event detail pages use clean keyword URLs: /event/<slug>
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s/+event\?(?:.*&)?id=([a-z0-9-]+)(?:&|\s) [NC]
  RewriteRule ^event/?$ https://%{HTTP_HOST}/event/%1? [R=301,L]
  RewriteRule ^event/([a-z0-9-]+)$ event.php?id=$1 [L,QSA]

  # Redirect legacy /page.html URLs to the clean extension-less URL
  # (index.html -> /, everything-else.html -> /everything-else). Must run
  # on the ORIGINAL request (THE_REQUEST), not the internally rewritten
  # one, so it never loops with the "serve .html for clean URL" rule below.
  # QSA re-appends the original query string, which %1 alone would drop.
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s/+index\.html[?\s] [NC]
  RewriteRule ^ https://%{HTTP_HOST}/ [R=301,L,QSA]
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s/+(.+)\.html[?\s] [NC]
  RewriteRule ^ https://%{HTTP_HOST}/%1 [R=301,L,QSA]

  # Redirect Trailing Slashes If not a folder
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} (.+)/$
  RewriteRule ^ https://%{HTTP_HOST}%1 [L,R=301]

  # Clean URLs (serve .php without extension if requested, e.g. /api/register)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.php -f
  RewriteRule ^([^\.]+)$ $1.php [NC,L]

  # Clean URLs (serve .html without extension if requested)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^([^\.]+)$ $1.html [NC,L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Content-Security-Policy "default-src 'self' https: data:; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://*.zohocdn.com https://*.zohopublic.com https://*.zohopublic.in https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: https: blob:; connect-src 'self' https: wss:; frame-src 'self' https://www.google.com https://maps.google.com https://www.youtube.com https://www.googletagmanager.com https://*.zohopublic.com https://*.zohopublic.in; object-src 'none'; base-uri 'self'; form-action 'self' https://*.zohopublic.in https://*.zohopublic.com; frame-ancestors 'self'; upgrade-insecure-requests"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set X-Permitted-Cross-Domain-Policies "none"
</IfModule>

# Caching & Compression for Fast Loading
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# CSS/JS/HTML must always be revalidated with the server (never served stale
# from browser cache) — content here changes on every deploy. Browser still
# gets a fast 304 when the file is unchanged, so this doesn't slow anything
# down; it just guarantees a real deploy is never masked by old cache.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Every CSS/JS reference in the pages carries ?v=<date>, so a versioned URL
  # never changes content: cache it for a year. Un-versioned URLs stay revalidated.
  <If "%{QUERY_STRING} =~ /(^|&)v=/ && %{REQUEST_URI} =~ /\.(css|js)$/">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
