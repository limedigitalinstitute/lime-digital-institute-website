{
  "type": "raw-html",
  "html": "  <form class=\"brochure-card\" id=\"brochureForm\" onsubmit=\"handleBrochureSubmit(event)\">\n    <div class=\"brochure-card-visual\">\n      <img src=\"assets/brochure-cover.jpg\" alt=\"Lime Digital Institute Digital Marketing Program brochure\" loading=\"lazy\">\n    </div>\n    <div class=\"brochure-form\">\n      <input type=\"text\" id=\"brochureName\" name=\"name\" placeholder=\"Enter first name\" required>\n      <input type=\"email\" id=\"brochureEmail\" name=\"email\" placeholder=\"Enter your email\" required>\n      <div class=\"brochure-phone\">\n        <select name=\"country_code\" id=\"brochureCountryCode\" class=\"curr-phone-prefix curr-country-select\" aria-label=\"Country Code\">\n          <option value=\"+91\" selected>🇮🇳 +91</option>\n          <option value=\"+1\">🇺🇸 +1</option>\n          <option value=\"+44\">🇬🇧 +44</option>\n          <option value=\"+971\">🇦🇪 +971</option>\n          <option value=\"+1\">🇨🇦 +1</option>\n          <option value=\"+61\">🇦🇺 +61</option>\n          <option value=\"+65\">🇸🇬 +65</option>\n          <option value=\"+966\">🇸🇦 +966</option>\n          <option value=\"+974\">🇶🇦 +974</option>\n          <option value=\"+968\">🇴🇲 +968</option>\n          <option value=\"+965\">🇰🇼 +965</option>\n          <option value=\"+973\">🇧🇭 +973</option>\n          <option value=\"+49\">🇩🇪 +49</option>\n          <option value=\"+33\">🇫🇷 +33</option>\n          <option value=\"+64\">🇳🇿 +64</option>\n          <option value=\"+60\">🇲🇾 +60</option>\n          <option value=\"+27\">🇿🇦 +27</option>\n          <option value=\"+81\">🇯🇵 +81</option>\n          <option value=\"+977\">🇳🇵 +977</option>\n          <option value=\"+880\">🇧🇩 +880</option>\n          <option value=\"+94\">🇱🇰 +94</option>\n        </select>\n        <input type=\"tel\" id=\"brochurePhone\" name=\"phone\" placeholder=\"Enter phone number\" pattern=\"[0-9]{7,15}\" maxlength=\"15\" required>\n      </div>\n      <label class=\"brochure-consent\" for=\"brochureConsent\">\n        <input type=\"checkbox\" id=\"brochureConsent\" name=\"consent\" checked>\n        <span>I agree to receive course updates from Lime Digital Institute on WhatsApp &amp; email.</span>\n      </label>\n    </div>\n    <button type=\"submit\" class=\"btn-brochure-submit\">Download Brochure PDF &rarr;</button>\n    <div class=\"brochure-trust\">\n      <span><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"20 6 9 17 4 12\"/></svg>100% data privacy</span>\n      <span><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"20 6 9 17 4 12\"/></svg>400+ enrolled</span>\n    </div>\n  </form>\n"
}