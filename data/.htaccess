# Block all direct HTTP access to this directory. It holds registrations,
# auth tokens, and events data — the PHP API reads these files from disk
# directly, so nothing legitimate needs them served over HTTP.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>
